# FlexSlot — environment variable names only.
# Copy this file to .env (same folder) and fill in the values yourself. .env is ignored by Git.
# Never put real values in this file, in chat, in logs, or in commits.

# --- PayPal (Sandbox only; never Live credentials) -------------------------
# developer.paypal.com > Apps & Credentials (Sandbox toggle) > your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox business account's Account ID (= merchant ID). Used to check the payee.
PAYPAL_EXPECTED_MERCHANT_ID=
# Needed only for V8 (webhook delivery). Leave empty for now.
PAYPAL_WEBHOOK_ID=
# The API base is fixed to https://api-m.sandbox.paypal.com. Do not add PAYPAL_API_BASE;
# any other value makes the app refuse to start.

# --- Google Cloud / Vertex AI (ADC login, no key file) ----------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Gemini model ID on Vertex AI used for structuring free text (checked by V9).
FLEXSLOT_AI_MODEL=
